{
  "manifest_version": 3,
  "name": "Roblox Images Fix (RF)",
  "version": "1.0.0",
  "description": "Возвращает загрузку иконок, обложек и аватарок на сайте Roblox в РФ: перенаправляет заблокированный tr.rbxcdn.com на CloudFront-зеркало.",
  "minimum_chrome_version": "88",
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.rbxcdn.com/*",
    "*://*.roblox.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rbx_images_fix_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
